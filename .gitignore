# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# IDEs
/.idea/*
!/.idea/runConfigurations
.vscode/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

